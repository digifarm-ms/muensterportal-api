# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Data files (wiki_embeddings.parquet is tracked for deployment)

# MediaWiki dumps — contain personal data (user emails, real names, password
# hashes). Never commit these. Keep local copies out of the index and out of
# the Docker build context (see .dockerignore).
wiki.sqlite
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
my_wiki.sqlite*

# Incident documentation stays OUT of this public repo. The wiki.sqlite runbook
# named the affected data subjects and their email addresses, so committing it
# re-published, as plain text, the personal data the incident was about. It is
# kept locally at ~/backups/m4u-incident-<date>/ instead.
docs/incident-*.md

# Environment
.env

# MediaWiki download
mediawiki-1.44.0/
mediawiki-1.44.0.tar.gz
